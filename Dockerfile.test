FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive VIDEO_ENGINE_REQUIRE_TOOLCHAIN=1 VIRTUAL_ENV=/opt/venv PATH="/opt/venv/bin:/root/.cargo/bin:${PATH}"
RUN apt-get update && apt-get install -y --no-install-recommends python3.12 python3.12-venv curl git ca-certificates ffmpeg xz-utils pkg-config libssl-dev build-essential && rm -rf /var/lib/apt/lists/* && python3.12 -m venv /opt/venv
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
WORKDIR /src
COPY . /src
RUN pip install --upgrade pip maturin && pip install -e ".[test]" faster-whisper google-genai && python -m maturin build --release -m rust/hypoverum_core_rs/Cargo.toml --out dist && pip install --force-reinstall dist/hypoverum_core_rs-*.whl
RUN python -m video_engine.cli doctor --install 2>&1 | tail -20
CMD ["python","-m","pytest","-q","tests/test_manifest_build.py","tests/test_hf_profile.py","tests/test_cache_lease.py"]
